{% extends 'layout.html' %}

{% set pageName = "" %}

{% macro primaryNavigation(activeItem, serviceName, bsoName) %}
  {{ header({
    account: {
      items: [
        {
          text: bsoName
        },
        {
          href: "#",
          text: "Thomas Pynchon",
          icon: true
        },
        {
          href: "/",
          text: "Log out"
        }
      ]
    },
    service: {
      text: serviceName,
      href: "/"
    },
    navigation: {
      items: [
        {
          href: "#",
          text: "Dashboard",
          active: activeItem === "Dashboard/home"
        },
        {
          href: "/participants/",
          text: "Participants",
          active: activeItem === "Participants"
        },
        {
          href: "/create-capacity-from-zero/",
          text: "Clinics",
          active: activeItem === "Clinics"
        },
        {
          href: "#",
          text: "Image reading",
          active: activeItem === "Image reading"
        },
        {
          href: "#",
          text: "Reports",
          active: activeItem === "Reports"
        },
        {
          href: "/bso-objects/",
          text: "BSO management",
          active: activeItem === "BSO management"
        },
        {
          href: "#",
          text: "Messages",
          active: activeItem === "Messages"
        },
        {
          href: "#",
          text: "Help and support",
          active: activeItem === "Help and support"
        }
      ]
    }
  }) }}
{% endmacro %}
{% block header %}
  {{ primaryNavigation("Clinics", serviceName, bsoName) }}
{% endblock %}

{% block beforeContent %}
<style type="text/css">
.app-calendar {
  container-type: inline-size;
}

.app-calendar ol {
  list-style: none;
  margin: 0;
  padding: 0;
}

.app-calendar li {
  background-color: white;
  border: 1px solid black;
  margin: 0;
  padding: 0;
}

/* Container query for tabular layout */
@container (min-width: 768px) {
  .app-calendar > ol {
    display: grid;
    grid-template-columns: 1;
    gap: 1.5rem;
    padding: 1rem;
  }

  .app-calendar > ol > li {
    border: none;
    padding: 0;
    background-color: transparent;
  }

  .app-calendar > ol > li h2 {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .app-calendar > ol > li > ol {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0;
    padding-top: 2.5rem;
    position: relative;
  }

  .app-calendar > ol > li > ol > li:nth-child(-n+7) {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .app-calendar > ol > li > ol > li:nth-child(1)::before { content: "Monday"; position: absolute; top: -2.25rem; left: 0; right: 0; font-weight: bold; font-size: 0.85rem; color: #333; padding-bottom: 0.25rem; }
  .app-calendar > ol > li > ol > li:nth-child(2)::before { content: "Tuesday"; position: absolute; top: -2.25rem; left: 0; right: 0; font-weight: bold; font-size: 0.85rem; color: #333; padding-bottom: 0.25rem; }
  .app-calendar > ol > li > ol > li:nth-child(3)::before { content: "Wednesday"; position: absolute; top: -2.25rem; left: 0; right: 0; font-weight: bold; font-size: 0.85rem; color: #333; padding-bottom: 0.25rem; }
  .app-calendar > ol > li > ol > li:nth-child(4)::before { content: "Thursday"; position: absolute; top: -2.25rem; left: 0; right: 0; font-weight: bold; font-size: 0.85rem; color: #333; padding-bottom: 0.25rem; }
  .app-calendar > ol > li > ol > li:nth-child(5)::before { content: "Friday"; position: absolute; top: -2.25rem; left: 0; right: 0; font-weight: bold; font-size: 0.85rem; color: #333; padding-bottom: 0.25rem; }
  .app-calendar > ol > li > ol > li:nth-child(6)::before { content: "Saturday"; position: absolute; top: -2.25rem; left: 0; right: 0; font-weight: bold; font-size: 0.85rem; color: #333; padding-bottom: 0.25rem; }
  .app-calendar > ol > li > ol > li:nth-child(7)::before { content: "Sunday"; position: absolute; top: -2.25rem; left: 0; right: 0; font-weight: bold; font-size: 0.85rem; color: #333; padding-bottom: 0.25rem; }

  .app-calendar > ol > li > ol > li {
    aspect-ratio: 1;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    border: 1px solid #999;
    padding: 0.5rem;
    text-align: left;
    font-size: 0.9rem;
    background-color: #fafafa;
  }

  .app-calendar > ol > li > ol > li:hover {
    background-color: #e8e8e8;
  }

  .app-calendar > ol > li > ol > li.app-calendar-empty {
    background-color: white;
    border: 1px solid #e0e0e0;
  }
}
</style>
{% endblock %}

